{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "abraxas.production-graph.v2"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "timebase": {
      "type": "object",
      "properties": {
        "fpsNumerator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fpsDenominator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "fpsNumerator",
        "fpsDenominator"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "a_roll",
              "b_roll",
              "xr",
              "image",
              "motion",
              "sfx",
              "music",
              "caption",
              "vo",
              "transition",
              "note"
            ]
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endFrame": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "ghost",
              "planned",
              "creating",
              "ready",
              "review",
              "approved",
              "failed"
            ]
          },
          "visualTypeId": {
            "type": "string"
          },
          "assetRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "kind",
          "startFrame",
          "endFrame",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "timebase",
    "events"
  ],
  "additionalProperties": false,
  "$id": "https://abraxas.local/schemas/production-graph.v2.json"
}
