{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "abraxas.job.v2"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "kind": {
      "type": "string"
    },
    "handler": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "inputFingerprint": {
      "type": "string"
    },
    "input": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "graph": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string",
              "const": "abraxas.production-graph.v2"
            },
            "projectId": {
              "type": "string",
              "minLength": 1
            },
            "timebase": {
              "type": "object",
              "properties": {
                "fpsNumerator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "fpsDenominator": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "fpsNumerator",
                "fpsDenominator"
              ],
              "additionalProperties": false
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "a_roll",
                      "b_roll",
                      "xr",
                      "image",
                      "motion",
                      "sfx",
                      "music",
                      "caption",
                      "vo",
                      "transition",
                      "note"
                    ]
                  },
                  "startFrame": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endFrame": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ghost",
                      "planned",
                      "creating",
                      "ready",
                      "review",
                      "approved",
                      "failed"
                    ]
                  },
                  "visualTypeId": {
                    "type": "string"
                  },
                  "assetRefs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "extensions": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "startFrame",
                  "endFrame",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaVersion",
            "projectId",
            "timebase",
            "events"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "graph"
      ],
      "additionalProperties": false
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxAttempts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "interrupted": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "projectId",
    "kind",
    "handler",
    "status",
    "inputFingerprint",
    "input",
    "sourceRevision",
    "progress",
    "attempt",
    "maxAttempts",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://abraxas.local/schemas/job.v2.json"
}
